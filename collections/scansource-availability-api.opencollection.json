{
  "opencollection": "1.0.0",
  "info": {
    "name": "ScanSource Invoice Availability API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Availability",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Product Availability",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://services.scansource.com/api/product/availability",
            "params": [
              {
                "name": "customerNumber",
                "value": "",
                "type": "query",
                "description": "Customer account number"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Ocp-Apim-Subscription-Key",
              "value": "{{Ocp-Apim-Subscription-Key}}",
              "placement": "header"
            }
          },
          "docs": "Check real-time inventory availability for one or more products. Recommended batch size is a maximum of 40 items per request. Used at point-of-demand to avoid unnecessary bulk downloads."
        }
      ]
    }
  ],
  "bundled": true
}